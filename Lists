if __name__ == '__main__':
    N = int(input())
    list1 = []
    for i in range(N):
        command = input().split()
        order = command[0]
        if order == 'insert':
            list1.insert(int(command[1]),int(command[2]))
        elif order == 'print':
            print(list1)
        elif order == 'remove':
            list1.remove(int(command[1]))   
        elif order == 'append':
            list1.append(int(command[1]))
        elif order == 'sort':
            list1.sort()
        elif order == 'pop':
            list1.pop()
        elif order == 'reverse':
            list1.reverse()        
            
            
           
